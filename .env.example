# Create your Telegram application at https://my.telegram.org/apps.
APP_ID=
APP_HASH=

# Optional: prefill the login form. Keep blank to enter it in the UI.
TG_PHONE=

# Local HTTP port (matches Google OAuth redirect URI port 22816).
PORT=22816

# Optional: path to Whisper GGML model for voice speech-to-text transcription
WHISPER_MODEL=../transcribe/ggml-tiny-q8_0.bin

# OAuth2 / JWT Stateless Session (Optional Single-Time Login Step)
AUTH_ENABLED=false
AUTH_URL=http://localhost:22816
AUTH_SECRET=

# Google OAuth Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:22816/oauth/v1/redirect/res

# GitHub OAuth Credentials
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URL=http://localhost:22816/oauth/v1/redirect/res
